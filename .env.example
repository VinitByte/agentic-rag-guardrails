# ---- Choose ONE LLM provider ----
# 1) Local & free (recommended to start): install Ollama, then `ollama pull llama3.1:8b`
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# 2) Any OpenAI-compatible API (OpenAI, Groq, Together, LM Studio, vLLM ...)
# LLM_PROVIDER=openai
# LLM_MODEL=llama-3.3-70b-versatile        # Groq free tier - check console.groq.com/docs/models for current names
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your_key_here

# 3) IBM watsonx.ai  (pip install ibm-watsonx-ai) -- check the current model id in your watsonx project
# LLM_PROVIDER=watsonx
# LLM_MODEL=ibm/granite-3-8b-instruct
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_API_KEY=your_key_here
# WATSONX_PROJECT_ID=your_project_id

# ---- Embeddings ----
# sentence-transformers = dense + TF-IDF hybrid retrieval; tfidf = sparse only (no model download)
EMBEDDER=sentence-transformers
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
